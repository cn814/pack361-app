# Supabase → Project Settings → API (both values are safe to expose to the browser;
# Row Level Security in the database protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to true once custom SMTP is configured and the Supabase "Magic link" email template
# includes the one-time code ({{ .Token }}). Until then the login page only mentions the link.
LOGIN_CODE_ENABLED=false
