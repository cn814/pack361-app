# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
LOGIN_CODE_ENABLED=true

# Server-only secrets (Vercel -> Settings -> Environment Variables; never commit real values)
# Supabase -> Project Settings -> API Keys -> Secret key. Used by the Givebutter sync, push alerts and calendar feed.
SUPABASE_SECRET_KEY=sb_secret_...
# Givebutter -> Settings -> Developers -> API -> New API key (needs Givebutter admin access)
GIVEBUTTER_API_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/givebutter
CRON_SECRET=
# Push alerts: run `npx web-push generate-vapid-keys` and paste both keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cnealen@gmail.com
