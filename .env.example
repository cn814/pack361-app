# ---------------------------------------------------------------------------
# Public (NEXT_PUBLIC_*): built into the browser code, so they must be safe to show anyone.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Push alerts: the public half of the VAPID key pair (the private half is below)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# PayPal pay buttons: the REST app's client ID (its secret is below)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: the app's address in links in emails (defaults to https://app.pack361.org)
# NEXT_PUBLIC_APP_URL=https://app.pack361.org

# ---------------------------------------------------------------------------
# Server only (Vercel -> Settings -> Environment Variables; never commit real values)
# ---------------------------------------------------------------------------
# Sign-in emails include a code as well as a link; set to false to go back to link-only emails.
LOGIN_CODE_ENABLED=true

# Supabase -> Project Settings -> API Keys -> Secret key. Used by both daily cron jobs, push alerts,
# admin alerts and the calendar feed.
SUPABASE_SECRET_KEY=sb_secret_...
# Givebutter -> Settings -> Developers -> API -> New API key (needs Givebutter admin access)
GIVEBUTTER_API_KEY=
# Any long random string; Vercel Cron sends it to both cron jobs (vercel.json):
#   /api/cron/givebutter (6 AM Eastern): Givebutter campaigns and orders, and matching dues paid there.
#   /api/cron/daily (5 PM Eastern): volunteer, training and registration reminders, deleting old
#   photos, finishing PayPal checkouts, then the TroopWebHost and council calendar syncs.
CRON_SECRET=
# Push alerts: run `npx web-push generate-vapid-keys` and paste the private key here (public key above)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@pack361.org

# Email (welcome emails, reminders, admin alerts) through Resend: API key with Sending access for
# pack361.org. Without it, email features stay switched off.
RESEND_API_KEY=
# Optional overrides
# EMAIL_FROM="Pack 361 <noreply@pack361.org>"
# EMAIL_REPLY_TO=info@pack361.org

# Bulk email (pack-wide announcements, den messages) through Brevo's free plan (300/day):
# Brevo -> SMTP & API -> API keys. Authenticate pack361.org in Brevo -> Senders, domains & IPs first.
BREVO_API_KEY=
# Optional: BREVO_SENDER="Pack 361 <news@pack361.org>" (defaults to EMAIL_FROM)

# PayPal pay buttons (/pay), optional. From developer.paypal.com -> Apps & Credentials, a REST app
# under the pack's PayPal Business account. Use the Sandbox app's keys first; switch to the Live
# app's keys and PAYPAL_ENV=live when ready. Without these, /pay still lists what's owed, the
# Givebutter dues button and the other ways to pay.
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# TroopWebHost calendar sync (optional; leave empty once the pack stops using TroopWebHost): an
# admin's link from TroopWebHost -> My Stuff -> Subscribe to Calendar. It's a private link (it signs
# in as that person): Secret, never in the repo.
TWH_CALENDAR_URL=

# EXPERIMENTAL (optional): read everyone's training straight from my.scouting (Leaders →
# Training → Import → "Get training from my.scouting"). Uses Scoutbook's unofficial connection
# with a Key 3 delegate's real my.scouting login, so it may stop working when Scouting America
# changes its site. Read-only. Leave empty to keep it off (the file upload always works).
# Mark the password Sensitive in Vercel.
MYSCOUTING_USERNAME=
MYSCOUTING_PASSWORD=
# Only if Pack 361 isn't found automatically:
MYSCOUTING_ORG_GUID=
