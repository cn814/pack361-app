# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
LOGIN_CODE_ENABLED=true

# Server-only secrets (Vercel -> Settings -> Environment Variables; never commit real values)
# Supabase -> Project Settings -> API Keys -> Secret key. Used by both daily cron jobs (Givebutter, reminders,
# TroopWebHost sync, photo clean-up), push alerts, admin alerts and the calendar feed.
SUPABASE_SECRET_KEY=sb_secret_...
# Givebutter -> Settings -> Developers -> API -> New API key (needs Givebutter admin access)
GIVEBUTTER_API_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/givebutter and /api/cron/daily
CRON_SECRET=
# Push alerts: run `npx web-push generate-vapid-keys` and paste both keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cnealen@gmail.com

# Email (welcome emails, reminders) through Resend: API key with Sending access for pack361.org.
# Without it, email features stay switched off.
RESEND_API_KEY=
# Optional overrides
# EMAIL_FROM="Pack 361 <noreply@pack361.org>"
# EMAIL_REPLY_TO=info@pack361.org
# NEXT_PUBLIC_APP_URL=https://app.pack361.org

# Bulk email (pack-wide announcements, den messages) through Brevo's free plan (300/day):
# Brevo -> SMTP & API -> API keys. Authenticate pack361.org in Brevo -> Senders, domains & IPs first.
BREVO_API_KEY=
# Optional: BREVO_SENDER="Pack 361 <news@pack361.org>" (defaults to EMAIL_FROM)

# TroopWebHost calendar sync (optional; leave empty once the pack stops using TroopWebHost): an admin's link from TroopWebHost -> My Stuff -> Subscribe to Calendar.
# It's a private link (it signs in as that person): Secret, never in the repo.
TWH_CALENDAR_URL=
# Optional: the pack's TroopWebHost home page, used when an event has no page of its own.
# NEXT_PUBLIC_TWH_URL=https://www.troopwebhostcs.org/Pack361EllicottCity/
